#
# find_package(holoscan-pcl-filters) defines:
#   holoscan::pcl_filters  VoxelDownsampleOp, CropBoxOp, GroundRemovalOp and OutlierRemovalOp,
#                          their CUDA filters, and the synthetic scene

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(
  holoscan
  5.0
  CONFIG
  COMPONENTS
  core
  sensor_io
)
find_dependency(CUDAToolkit)

include("${CMAKE_CURRENT_LIST_DIR}/holoscan-pcl-filters-targets.cmake")

check_required_components(holoscan-pcl-filters)
