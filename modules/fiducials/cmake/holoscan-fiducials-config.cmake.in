#
# find_package(holoscan-fiducials [COMPONENTS overlay]) defines:
#   holoscan::fiducials          ArucoDetectorOp, CharucoDetectorOp, the backends, the
#                                dictionaries, poses, ChArUco boards and the synthetic scenes
#   holoscan::fiducials_overlay  FiducialOverlayOp (when the overlay component was built)

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(
  holoscan
  5.0
  CONFIG
  COMPONENTS
  @HOLOSCAN_FIDUCIALS_HOLOSCAN_COMPONENTS@
)
find_dependency(CUDAToolkit)

include("${CMAKE_CURRENT_LIST_DIR}/holoscan-fiducials-targets.cmake")

if(TARGET holoscan::fiducials_overlay)
  set(holoscan-fiducials_overlay_FOUND TRUE)
else()
  set(holoscan-fiducials_overlay_FOUND FALSE)
endif()
check_required_components(holoscan-fiducials)
