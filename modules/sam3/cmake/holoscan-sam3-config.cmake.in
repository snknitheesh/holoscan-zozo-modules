#
# find_package(holoscan-sam3 [COMPONENTS overlay]) defines:
#   holoscan::sam3                 Sam3SegmentationOp, prepare_engines(), its kernels, the
#                                  prompt table, and the stub model, synthetic scene and
#                                  host references
#   holoscan::sam3_overlay         Sam3OverlayOp (when the overlay component was built)
#   holoscan-sam3_PREPARE_MODEL    The installed prepare_model.py, which exports SAM 3 to
#                                  ONNX with a separately installed PyTorch and Transformers

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(
  holoscan
  5.0
  CONFIG
  COMPONENTS
  @HOLOSCAN_SAM3_HOLOSCAN_COMPONENTS@
)
find_dependency(CUDAToolkit)

include("${CMAKE_CURRENT_LIST_DIR}/holoscan-sam3-targets.cmake")

set(holoscan-sam3_PREPARE_MODEL "@PACKAGE_HOLOSCAN_SAM3_PREPARE_MODEL@")
if(TARGET holoscan::sam3_overlay)
  set(holoscan-sam3_overlay_FOUND TRUE)
else()
  set(holoscan-sam3_overlay_FOUND FALSE)
endif()
check_required_components(holoscan-sam3)
