#
# find_package(holoscan-image-quality) defines:
#   holoscan::image_quality  ImageQualityOp, the GPU analyzer, the evaluator, the CPU
#                            reference and the synthetic scenes

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(
  holoscan
  5.0
  CONFIG
  COMPONENTS
  core
  sensor_io
)
find_dependency(CUDAToolkit)

include("${CMAKE_CURRENT_LIST_DIR}/holoscan-image-quality-targets.cmake")

check_required_components(holoscan-image-quality)
