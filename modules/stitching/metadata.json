{
  "$schema": "urn:holoscan:module:v2",
  "module": {
    "name": "holoscan-stitching",
    "version": "1.0.0",
    "support_level": "community",
    "description": "Multi-camera stitching on the GPU: one image from each camera of a calibrated rig (pinhole Brown-Conrady, rational or Kannala-Brandt fisheye) into a cylindrical or spherical panorama or a bird's-eye surround view of the ground, from remap tables built once per calibration, with bilinear sampling, distance-weighted feathering or hard seams, and optional per-camera exposure compensation.",
    "authors": [
      {
        "name": "zozo",
        "affiliation": "Independent"
      }
    ],
    "license": "Apache-2.0",
    "language": [
      "C++"
    ],
    "namespace": {
      "cpp": "holoscan::stitching"
    },
    "holoscan_sdk": {
      "minimum_required_version": "5.0.0",
      "tested_versions": [
        "5.0.0"
      ]
    },
    "platforms": [
      "x86_64",
      "aarch64"
    ],
    "tags": [
      "Robotics",
      "Computer Vision and Perception",
      "Stitching",
      "Panorama",
      "Surround View",
      "Camera",
      "CUDA"
    ],
    "homepage": "https://github.com/snknitheesh/holoscan-zozo-modules/tree/main/modules/stitching",
    "source_repository": "https://github.com/snknitheesh/holoscan-zozo-modules",
    "operator_names": [
      "StitchOp"
    ],
    "requirements": {
      "hardware": [
        {
          "name": "NVIDIA GPU",
          "description": "A CUDA-capable GPU supported by the Holoscan SDK."
        }
      ]
    },
    "dependencies": [],
    "binary_packages": {
      "debian": "holoscan-stitching",
      "install_commands": [
        "sudo apt install ./holoscan-stitching_1.0.0_$(dpkg --print-architecture).deb"
      ]
    },
    "testing": {
      "cpp": "ctest"
    },
    "documentation": {
      "readme": "README.md"
    }
  }
}
