#
# find_package(holoscan-stitching) defines:
#   holoscan::stitching  StitchOp, the GPU Stitcher, the rig calibration and output
#                        geometry, the CPU reference, and the synthetic world

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(
  holoscan
  5.0
  CONFIG
  COMPONENTS
  core
  sensor_io
)
find_dependency(CUDAToolkit)

include("${CMAKE_CURRENT_LIST_DIR}/holoscan-stitching-targets.cmake")

check_required_components(holoscan-stitching)
