#
# find_package(holoscan-codec) defines:
#   holoscan::codec           VideoEncoderOp, VideoDecoderOp, VideoEncoder, VideoDecoder, the
#                             Annex-B reader and the test video
#   holoscan-codec_WITH_V4L2  Whether the v4l2 backend (Jetson V4L2 codec devices) was built

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(
  holoscan
  5.0
  CONFIG
  COMPONENTS
  core
  sensor_io
)
find_dependency(CUDAToolkit)

include("${CMAKE_CURRENT_LIST_DIR}/holoscan-codec-targets.cmake")

set(holoscan-codec_WITH_V4L2 @HOLOSCAN_CODEC_V4L2@)
check_required_components(holoscan-codec)
