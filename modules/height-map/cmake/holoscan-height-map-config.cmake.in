#
# find_package(holoscan-height-map) defines:
#   holoscan::height_map  HeightMapOp and TraversabilityOp, their CUDA kernels, the color views
#                         and the synthetic terrain

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(
  holoscan
  5.0
  CONFIG
  COMPONENTS
  core
  sensor_io
)
find_dependency(CUDAToolkit)

include("${CMAKE_CURRENT_LIST_DIR}/holoscan-height-map-targets.cmake")

check_required_components(holoscan-height-map)
