#
# find_package(holoscan-icp) defines:
#   holoscan::icp  IcpOp, which takes and sends holoscan-messages' PointCloud, the GPU
#                  registration and odometry it runs, and the synthetic scenes with known
#                  camera poses

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(
  holoscan
  5.0
  CONFIG
  COMPONENTS
  core
  sensor_io
)
find_dependency(CUDAToolkit)
find_dependency(holoscan-messages 1.0 CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/holoscan-icp-targets.cmake")

check_required_components(holoscan-icp)
