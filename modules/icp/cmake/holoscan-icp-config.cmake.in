#
# find_package(holoscan-icp) defines:
#   holoscan::icp  IcpOp, the GPU registration and odometry it runs, and the synthetic
#                  scenes with known camera poses

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(
  holoscan
  5.0
  CONFIG
  COMPONENTS
  core
  sensor_io
)
find_dependency(CUDAToolkit)

include("${CMAKE_CURRENT_LIST_DIR}/holoscan-icp-targets.cmake")

check_required_components(holoscan-icp)
