#
# find_package(holoscan-stereo-camera) defines:
#   holoscan::stereo_camera               StereoCameraOp, its backends, the calibration and its
#                                         message, recordings and the synthetic camera
#   holoscan-stereo-camera_WITH_REALSENSE Whether the realsense backend was built

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(
  holoscan
  5.0
  CONFIG
  COMPONENTS
  core
  sensor_io
)
find_dependency(CUDAToolkit)

include("${CMAKE_CURRENT_LIST_DIR}/holoscan-stereo-camera-targets.cmake")

set(holoscan-stereo-camera_WITH_REALSENSE @HOLOSCAN_STEREO_CAMERA_REALSENSE@)
check_required_components(holoscan-stereo-camera)
