#
# find_package(holoscan-clustering) defines:
#   holoscan::clustering  EuclideanClusterOp, the clusterer it runs, drawing clusters for display,
#                         and the synthetic scene

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(
  holoscan
  5.0
  CONFIG
  COMPONENTS
  core
  sensor_io
)
find_dependency(CUDAToolkit)

include("${CMAKE_CURRENT_LIST_DIR}/holoscan-clustering-targets.cmake")

check_required_components(holoscan-clustering)
