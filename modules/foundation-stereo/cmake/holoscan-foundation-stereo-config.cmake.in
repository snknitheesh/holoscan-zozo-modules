#
# find_package(holoscan-foundation-stereo) defines:
#   holoscan::foundation_stereo                FoundationStereoOp, prepare_engine(), the
#                                              kernels, the geometry message, and the stub
#                                              model and synthetic scene
#   holoscan-foundation-stereo_PREPARE_MODEL   The installed prepare_model.py, which fetches
#                                              or exports a Fast-FoundationStereo model

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(
  holoscan
  5.0
  CONFIG
  COMPONENTS
  core
  sensor_io
  inference
)
find_dependency(CUDAToolkit)

include("${CMAKE_CURRENT_LIST_DIR}/holoscan-foundation-stereo-targets.cmake")

set(holoscan-foundation-stereo_PREPARE_MODEL "@PACKAGE_HOLOSCAN_FOUNDATION_STEREO_PREPARE_MODEL@")
check_required_components(holoscan-foundation-stereo)
