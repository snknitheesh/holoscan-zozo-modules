#
# find_package(holoscan-rectify) defines:
#   holoscan::rectify          UndistortOp, StereoRectifyOp, the lens models, the geometry,
#                              the remap backends and the synthetic scene
#   holoscan-rectify_WITH_VPI  Whether the vpi-* backends were built

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(
  holoscan
  5.0
  CONFIG
  COMPONENTS
  core
  sensor_io
)
find_dependency(CUDAToolkit)
find_dependency(holoscan-messages 1.0 CONFIG)
# A static library passes VPI, which it links privately, on to its consumers' link.
if(@HOLOSCAN_RECTIFY_VPI@ AND NOT "@BUILD_SHARED_LIBS@")
  find_dependency(
    vpi
    4
    CONFIG
    PATHS
    /opt/nvidia/vpi4
  )
endif()

include("${CMAKE_CURRENT_LIST_DIR}/holoscan-rectify-targets.cmake")

set(holoscan-rectify_WITH_VPI @HOLOSCAN_RECTIFY_VPI@)
check_required_components(holoscan-rectify)
