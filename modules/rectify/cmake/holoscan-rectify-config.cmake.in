#
# find_package(holoscan-rectify) defines:
#   holoscan::rectify          UndistortOp, StereoRectifyOp, the calibration loaders, the
#                              geometry, the remap backends and the synthetic scene
#   holoscan-rectify_WITH_VPI  Whether the vpi-* backends were built

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(
  holoscan
  5.0
  CONFIG
  COMPONENTS
  core
  sensor_io
)
find_dependency(CUDAToolkit)

include("${CMAKE_CURRENT_LIST_DIR}/holoscan-rectify-targets.cmake")

set(holoscan-rectify_WITH_VPI @HOLOSCAN_RECTIFY_VPI@)
check_required_components(holoscan-rectify)
