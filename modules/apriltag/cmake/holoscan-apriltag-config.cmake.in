#
# find_package(holoscan-apriltag [COMPONENTS overlay]) defines:
#   holoscan::apriltag          AprilTagDetectorOp, the detector backends, pose estimation and
#                               the synthetic scenes
#   holoscan::apriltag_overlay  AprilTagOverlayOp (when the overlay component was built)
#   holoscan-apriltag_WITH_VPI  Whether the vpi backend was built

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(holoscan 5.0 CONFIG COMPONENTS @HOLOSCAN_APRILTAG_HOLOSCAN_COMPONENTS@)
find_dependency(CUDAToolkit)

include("${CMAKE_CURRENT_LIST_DIR}/holoscan-apriltag-targets.cmake")

set(holoscan-apriltag_WITH_VPI @HOLOSCAN_APRILTAG_VPI@)
if(TARGET holoscan::apriltag_overlay)
  set(holoscan-apriltag_overlay_FOUND TRUE)
else()
  set(holoscan-apriltag_overlay_FOUND FALSE)
endif()
check_required_components(holoscan-apriltag)
