{
  "$schema": "urn:holoscan:module:v2",
  "module": {
    "name": "holoscan-point-cloud",
    "version": "1.0.0",
    "support_level": "community",
    "description": "Depth images (uint16 or float32, with optional aligned color and per-frame intrinsics) deprojected into organized, optionally colored, XYZ point clouds on the GPU.",
    "authors": [
      {
        "name": "zozo",
        "affiliation": "Independent"
      }
    ],
    "license": "Apache-2.0",
    "language": [
      "C++"
    ],
    "namespace": {
      "cpp": "holoscan::point_cloud"
    },
    "holoscan_sdk": {
      "minimum_required_version": "5.0.0",
      "tested_versions": [
        "5.0.0"
      ]
    },
    "platforms": [
      "x86_64",
      "aarch64"
    ],
    "tags": [
      "Robotics",
      "Computer Vision and Perception",
      "Point Cloud",
      "Depth",
      "3D",
      "CUDA"
    ],
    "homepage": "https://github.com/snknitheesh/holoscan-zozo-modules/tree/main/modules/point-cloud",
    "source_repository": "https://github.com/snknitheesh/holoscan-zozo-modules",
    "operator_names": [
      "DepthToPointCloudOp"
    ],
    "requirements": {
      "hardware": [
        {
          "name": "NVIDIA GPU",
          "description": "A CUDA-capable GPU supported by the Holoscan SDK."
        }
      ]
    },
    "dependencies": [],
    "binary_packages": {
      "debian": "holoscan-point-cloud",
      "install_commands": [
        "sudo apt install ./holoscan-point-cloud_1.0.0_$(dpkg --print-architecture).deb"
      ]
    },
    "testing": {
      "cpp": "ctest"
    },
    "documentation": {
      "readme": "README.md"
    }
  }
}
