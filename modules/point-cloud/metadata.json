{
  "$schema": "urn:holoscan:module:v2",
  "module": {
    "name": "holoscan-point-cloud",
    "version": "2.0.0",
    "support_level": "community",
    "description": "Point clouds on the GPU in both directions, on the messages of holoscan-messages: depth images (uint16 or float32, with optional aligned color) and the depth camera's CameraInfo deprojected into organized, optionally colored PointCloud messages, and PointCloud messages projected through extrinsics into the pinhole camera a CameraInfo describes, as z-buffered depth images (float32 or uint16) with optional color.",
    "authors": [
      {
        "name": "zozo",
        "affiliation": "Independent"
      }
    ],
    "license": "Apache-2.0",
    "language": [
      "C++"
    ],
    "namespace": {
      "cpp": "holoscan::point_cloud"
    },
    "holoscan_sdk": {
      "minimum_required_version": "5.0.0",
      "tested_versions": [
        "5.0.0"
      ]
    },
    "platforms": [
      "x86_64",
      "aarch64"
    ],
    "tags": [
      "Robotics",
      "Computer Vision and Perception",
      "Point Cloud",
      "Depth",
      "3D",
      "CUDA"
    ],
    "homepage": "https://github.com/snknitheesh/holoscan-zozo-modules/tree/main/modules/point-cloud",
    "source_repository": "https://github.com/snknitheesh/holoscan-zozo-modules",
    "operator_names": [
      "DepthToPointCloudOp",
      "PointCloudToDepthOp"
    ],
    "requirements": {
      "hardware": [
        {
          "name": "NVIDIA GPU",
          "description": "A CUDA-capable GPU supported by the Holoscan SDK."
        }
      ]
    },
    "dependencies": [
      {
        "name": "messages"
      }
    ],
    "binary_packages": {
      "debian": "holoscan-point-cloud",
      "install_commands": [
        "sudo apt install ./holoscan-messages_1.0.0_$(dpkg --print-architecture).deb ./holoscan-point-cloud_2.0.0_$(dpkg --print-architecture).deb"
      ]
    },
    "testing": {
      "cpp": "ctest"
    },
    "documentation": {
      "readme": "README.md"
    }
  }
}
