#
# find_package(holoscan-normals) defines:
#   holoscan::normals  NormalEstimationOp and PlaneSegmentationOp, their CUDA kernels, the
#                      color views and the synthetic scene

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(
  holoscan
  5.0
  CONFIG
  COMPONENTS
  core
  sensor_io
)
find_dependency(CUDAToolkit)

include("${CMAKE_CURRENT_LIST_DIR}/holoscan-normals-targets.cmake")

check_required_components(holoscan-normals)
