#
# find_package(holoscan-normals) defines:
#   holoscan::normals  NormalEstimationOp and PlaneSegmentationOp, their CUDA kernels, the
#                      color views and the synthetic scene, on holoscan-messages' PointCloud

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(
  holoscan
  5.0
  CONFIG
  COMPONENTS
  core
)
find_dependency(CUDAToolkit)
find_dependency(holoscan-messages 1.0 CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/holoscan-normals-targets.cmake")

check_required_components(holoscan-normals)
