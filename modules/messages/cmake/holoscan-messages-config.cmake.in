#
# find_package(holoscan-messages) defines:
#   holoscan::messages  The CameraInfo, StereoCameraInfo and PointCloud messages, their plain
#                       values and checks, the camera_info YAML files, the consumer contract,
#                       the point cloud helpers and CameraInfoSourceOp

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(
  holoscan
  5.0
  CONFIG
  COMPONENTS
  core
)
find_dependency(CUDAToolkit)

include("${CMAKE_CURRENT_LIST_DIR}/holoscan-messages-targets.cmake")

check_required_components(holoscan-messages)
