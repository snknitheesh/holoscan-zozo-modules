#
# find_package(holoscan-tsdf) defines:
#   holoscan::tsdf  TsdfVolume, MeshExtractor, TsdfIntegrateOp, TsdfMeshOp and the synthetic
#                   scene

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(
  holoscan
  5.0
  CONFIG
  COMPONENTS
  core
  sensor_io
)
find_dependency(CUDAToolkit)

include("${CMAKE_CURRENT_LIST_DIR}/holoscan-tsdf-targets.cmake")

check_required_components(holoscan-tsdf)
