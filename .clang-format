BasedOnStyle: Google
ColumnLimit: 100
IndentWidth: 2
AccessModifierOffset: -1
PointerAlignment: Left
IncludeBlocks: Regroup
# Order: related header, C system, C++ standard, third-party (<...hpp>/<pkg/...>), project ("...").
# Matches cpplint's build/include_order grouping so both tools agree.
IncludeCategories:
  - Regex: '^<ext/.*\.h>'
    Priority: 2
    SortPriority: 0
    CaseSensitive: false
  - Regex: '^<[^/]*\.h>'
    Priority: 1
  - Regex: '^<[^/.]*>'
    Priority: 2
  - Regex: '^<.*>'
    Priority: 3
  - Regex: '.*'
    Priority: 4
